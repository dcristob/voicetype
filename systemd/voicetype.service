[Unit]
Description=VoiceType dictation daemon
After=graphical-session.target ydotoold.service
Wants=ydotoold.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=YDOTOOL_SOCKET=%t/.ydotool_socket
ExecStart=%h/.local/bin/voicetyped
Restart=on-failure
RestartSec=2

# default.target is reached on every login across GNOME/Budgie/COSMIC; some
# Wayland sessions (e.g. Budgie) never activate graphical-session.target, so
# anchoring there means the service is never started on boot.
[Install]
WantedBy=default.target
